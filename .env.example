# public address of this site (canonical, sitemap, robots), local: http://localhost:4350
NEXT_PUBLIC_SITE_URL=http://localhost:4350
# address of the api, used on the server only
API_URL=http://localhost:4200/api
# the id (GUID) of this client from the `clients` table, used on the server only
ACCESS_KEY=
# extra hosts the drink images are served from, separated by a comma (*.r2.dev is always allowed)
IMAGE_HOSTS=
# true: show the site even while it is a draft (a draft shows a "coming soon" page), for developing
SHOW_DRAFT=false

# the shared secret with the api: after a change in the dashboard the api calls /api/revalidate with it, so the change shows right away
REVALIDATE_SECRET=
